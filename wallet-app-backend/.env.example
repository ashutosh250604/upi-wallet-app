# Copy to .env for local development, or set these in the hosting dashboard.

# Postgres (Neon) connection string. Falls back to a local SQLite file when unset.
# Paste the provider's URL verbatim; the psycopg2 driver is added automatically.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign session tokens. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-secret-change-me

# Sandbox behaviour: seeded accounts, one-tap sample login and OTP returned in the API response.
DEMO_MODE=false
DEMO_MOBILE=9000000001

# UPI-style handle suffix for generated UPI IDs, e.g. 9000000001@okwalletpay
VPA_SUFFIX=okwalletpay

# Daily sending cap per account, enforced by the ledger on every debit. 0 lifts the cap.
MAX_DAILY_RUPEES=100000

# Minutes to add to UTC to find the limit day's local midnight. 330 is IST, which puts the
# reset at 00:00 in India instead of 05:30 in the morning.
LIMIT_TZ_OFFSET_MINUTES=330

# Ceiling for any single payment, and for one top-up.
MAX_TRANSFER_RUPEES=100000

# Comma-separated browser origins allowed to call the API (Vite dev servers).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session lifetime in hours.
JWT_EXPIRES_HOURS=12

# How long an OTP stays valid.
OTP_TTL_MINUTES=5
